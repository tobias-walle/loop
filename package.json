{
  "name": "loop",
  "version": "0.1.0",
  "description": "A CLI tool that runs coding agents in loops and sequences with a minimal TUI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loop": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist", "src/templates"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node && chmod +x dist/index.js",
    "test": "bun test",
    "check": "biome check --write --unsafe .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "^0.63.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.0.0",
    "knip": "^5.0.0",
    "typescript": "^5.7.0"
  }
}
