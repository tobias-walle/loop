{
  "name": "loop",
  "version": "0.1.0",
  "description": "A CLI tool that runs coding agents in loops and sequences with a minimal TUI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loop": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src/templates"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --outfile dist/cli.js --target node && bun scripts/ensure-cli-shebang.ts dist/cli.js && bun build src/index.ts --outdir dist --target node",
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "check": "sh scripts/check.sh",
    "check:biome": "biome check --write --unsafe . --error-on-warnings --max-diagnostics=50",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:test": "bun test --reporter=dots --bail --path-ignore-patterns='*.integration.*'",
    "test:integration": "bun test --bail 'integration'",
    "check:knip": "knip --no-config-hints",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "^0.73.1",
    "commander": "^15.0.0",
    "execa": "^10.0.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.7.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/proper-lockfile": "^4.1.4",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.29.0",
    "typescript": "^7.0.2"
  }
}
